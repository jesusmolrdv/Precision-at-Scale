root ::= Caption
Caption ::= "{"   ws   "\"concept\":"   ws   string   ","   ws   "\"image_caption\":"   ws   string   "}"
Captionlist ::= "[]" | "["   ws   Caption   (","   ws   Caption)*   "]"
string ::= "\""   ([^"]*)   "\""
boolean ::= "true" | "false"
ws ::= [ \t\n]*
number ::= [0-9]+   "."?   [0-9]*
stringlist ::= "["   ws   "]" | "["   ws   string   (","   ws   string)*   ws   "]"
numberlist ::= "["   ws   "]" | "["   ws   string   (","   ws   number)*   ws   "]"
