root ::= Expansion
Expansion ::= "{"   ws   "\"original_concept\":"   ws   string   ","   ws   "\"new_concepts\":"   ws   stringlist   "}"
Expansionlist ::= "[]" | "["   ws   Expansion   (","   ws   Expansion)*   "]"
string ::= "\""   ([^"]*)   "\""
boolean ::= "true" | "false"
ws ::= [ \t\n]*
number ::= [0-9]+   "."?   [0-9]*
stringlist ::= "["   ws   "]" | "["   ws   string   (","   ws   string)*   ws   "]"
numberlist ::= "["   ws   "]" | "["   ws   string   (","   ws   number)*   ws   "]"
